# Copy to .env and edit. ALL optional — DxForge runs fully without any of these.
# LLM is only used to rescue natural-language parser misses and is clamped to the KB.

LLM_PROVIDER=none            # none | ollama | openai

# --- ollama (local, private) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- openai-compatible (bring your own key; never commit real keys) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
